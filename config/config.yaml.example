server:
  mode: release  # debug, release, test
  http_port: 9876
  rpc_port: 9090
  read_timeout: 60000  # 毫秒
  write_timeout: 60000 # 毫秒
  jwt_secret: "your-secret-key-change-in-production"  # JWT密钥

database:
  driver: mysql
  host: mysql
  port: 3306
  database: opshub
  username: root
  password: "your-password"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600 # 秒

redis:
  host: redis
  port: 6379
  password: ""
  db: 0
  pool_size: 10
  min_idle_conn: 5

desktop:
  enabled: false
  provider: guacamole
  public_path: /guacamole/
  token_ttl_seconds: 30
  json_secret_key: "0123456789abcdef0123456789abcdef"
  recording_path: /var/lib/guacamole/recordings
  transfer_root_path: /var/lib/guacamole
  drive_name: OpsHub Files
  disable_upload: false
  disable_download: false

terminal:
  recording_path: ./data/terminal-recordings

agent:
  enabled: true
  bundle_dir: ./agent-bundles
  default_install_path: /opt/opshub-agent
  default_listen_port: 19100
  binary_name: opshub-agent
  service_prefix: opshub-agent
  report_interval_seconds: 60

monitoring:
  prometheus:
    enabled: true
    base_url: http://prometheus:9090
    file_sd_dir: ./data/prometheus/file_sd
    query_timeout_seconds: 10

log:
  level: info  # debug, info, warn, error
  filename: logs/app.log
  max_size: 100      # MB
  max_backups: 10
  max_age: 30        # days
  compress: true
  console: true
