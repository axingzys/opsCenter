COMPOSE_PROJECT_NAME=opshub
TZ=Asia/Shanghai

IMAGE_TAG=latest
BACKEND_REPOSITORY=opshub-api
FRONTEND_REPOSITORY=opshub-web

MYSQL_IMAGE=mysql:8.0.44
REDIS_IMAGE=redis:7-alpine
GUACD_IMAGE=guacamole/guacd:1.6.0
GUACAMOLE_IMAGE=guacamole/guacamole:1.6.0
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1

FRONTEND_PORT=80
BACKEND_PORT=9876
MYSQL_PORT=23306
REDIS_PORT=26390
GUACAMOLE_PORT=18080
PROMETHEUS_PORT=19090

MYSQL_DATABASE=opshub
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=123456
REDIS_PASSWORD=123456
OPSHUB_REDIS_DB=0

OPSHUB_SERVER_MODE=release
OPSHUB_SERVER_JWT_SECRET=opshub-jwt-secret-change-in-production
OPSHUB_SERVER_EXTERNAL_URL=http://localhost:9876
OPSHUB_SERVER_FRONTEND_URL=http://localhost

OPSHUB_DESKTOP_ENABLED=false
OPSHUB_DESKTOP_PUBLIC_PATH=/guacamole/
OPSHUB_DESKTOP_TOKEN_TTL_SECONDS=30
OPSHUB_DESKTOP_DRIVE_NAME="OpsHub Files"
OPSHUB_DESKTOP_DISABLE_UPLOAD=false
OPSHUB_DESKTOP_DISABLE_DOWNLOAD=false
GUACAMOLE_JSON_SECRET_KEY=7f2d4a9c1b6e8d0f5a3c7e1b9d4f6a2c

OPSHUB_AGENT_ENABLED=true
OPSHUB_AGENT_DEFAULT_INSTALL_PATH=/opt/opshub-agent
OPSHUB_AGENT_DEFAULT_LISTEN_PORT=19100
OPSHUB_AGENT_BINARY_NAME=opshub-agent
OPSHUB_AGENT_SERVICE_PREFIX=opshub-agent
OPSHUB_AGENT_REPORT_INTERVAL_SECONDS=60

OPSHUB_MONITORING_PROMETHEUS_ENABLED=false
OPSHUB_MONITORING_PROMETHEUS_BASE_URL=http://prometheus:9090
OPSHUB_MONITORING_PROMETHEUS_QUERY_TIMEOUT_SECONDS=10
PROMETHEUS_RETENTION_TIME=15d
